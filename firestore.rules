rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    match /test/connection {
      allow read, write: if true;
    }
  }
}
